# -----------------------------
# Portfolio.Ai local OAuth setup
# Copy this file to `.env` and fill real values.
# -----------------------------

# Frontend + backend shared App ID from your OAuth provider
VITE_APP_ID=your_app_id

# Google OAuth client id (Web application)
# Example: 1234567890-abc123def456.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=

# Google OAuth client secret (starts with GOCSPX-...)
GOOGLE_OAUTH_CLIENT_SECRET=

# Frontend URL users are redirected to for sign-in UI
# Example: https://auth.your-company.com
VITE_OAUTH_PORTAL_URL=https://your-oauth-portal.example.com

# Backend OAuth API base URL for token + userinfo exchange
# Example: https://auth-api.your-company.com
OAUTH_SERVER_URL=https://your-oauth-api.example.com

# Required for JWT session cookie signing (use a long random secret)
JWT_SECRET=replace_with_a_long_random_secret

# Optional: mark a specific openId as admin in DB
OWNER_OPEN_ID=

# Optional DB connection (user upsert will be skipped if omitted)
DATABASE_URL=

# Optional analytics variables (set to avoid placeholder warnings)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
